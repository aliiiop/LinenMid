  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#00E5FF><b>\u041A\u041E\u041C\u0410\u041D\u0414\u0410</b></color>\n\u0416\u0430\u043A\u0441\u044B\u0431\u0430\u0435\u0432 \u0410\u043B\u0438\u0441\u043A\u0435\u0440\n\u0412\u0430\u0433\u043D\u0435\u0440 \u0410\u043B\u044C\u0431\u0435\u0440\u0442\n\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435, \u0433\u0435\u0439\u043C-\u0434\u0438\u0437\u0430\u0439\u043D, \u043A\u0430\u0440\u0442\u0430, \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\n\n<color=#00E5FF><b>\u0421\u041E\u0411\u0421\u0422\u0412\u0415\u041D\u041D\u042B\u0415 \u0410\u0421\u0421\u0415\u0422\u042B</b></color>\n\u041A\u0430\u0440\u0442\u0430 Neon City, \u0431\u0430\u0448\u043D\u0438, Ancient, \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430, \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B\u044B (\u0441\u043E\u0431\u0440\u0430\u043D\u044B \u0438\u0437 \u043F\u0440\u0438\u043C\u0438\u0442\u0438\u0432\u043E\u0432 \u0432 Unity)\n\u041F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u043D\u044B\u0435 \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u044B: \u043D\u0435\u043E\u043D\u043E\u0432\u0430\u044F \u0441\u0435\u0442\u043A\u0430, \u043E\u043A\u043D\u0430 \u043D\u0435\u0431\u043E\u0441\u043A\u0440\u0451\u0431\u043E\u0432 (Assets/Textures, \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440 \u0432 Assets/Editor)\n\u041F\u0440\u0438\u0446\u0435\u043B (Sources/Crosshair.xcf), \u044D\u0444\u0444\u0435\u043A\u0442\u044B \u0447\u0430\u0441\u0442\u0438\u0446, \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B\n\n<color=#00E5FF><b>\u0414\u0412\u0418\u0416\u041E\u041A</b></color>\nUnity 6, URP, AI Navigation, TextMesh Pro"
  m_isRightToLeft: 0
