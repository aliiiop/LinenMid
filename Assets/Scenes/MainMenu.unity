--- !u!114 &479826959
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 479826957}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#00E5FF><b>\u0426\u0415\u041B\u042C</b></color>\n\u0420\u0430\u0437\u0440\u0443\u0448\u044C \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0439 Ancient (\u0440\u0435\u0430\u043A\u0442\u043E\u0440 \u043A\u0440\u0430\u0441\u043D\u043E\u0439 \u0431\u0430\u0437\u044B) \u0440\u0430\u043D\u044C\u0448\u0435, \u0447\u0435\u043C \u0432\u0440\u0430\u0433\u0438 \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u0442 \u0442\u0432\u043E\u0439.\n\n<color=#00E5FF><b>\u041F\u041E\u0420\u042F\u0414\u041E\u041A</b></color>\n\u041D\u0430 \u043A\u0430\u0436\u0434\u043E\u0439 \u043B\u0438\u043D\u0438\u0438 2 \u0431\u0430\u0448\u043D\u0438. \u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u044F\u044F \u0431\u0430\u0448\u043D\u044F \u0438 Ancient \u043F\u043E\u0434 \u0449\u0438\u0442\u043E\u043C, \u043F\u043E\u043A\u0430 \u0436\u0438\u0432\u0430 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430. \u0411\u0435\u0437 \u0441\u0432\u043E\u0438\u0445 \u043C\u0438\u043D\u044C\u043E\u043D\u043E\u0432 \u0440\u044F\u0434\u043E\u043C \u0431\u0430\u0448\u043D\u044F \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u043D\u0430 70% \u043C\u0435\u043D\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430.\n\n<color=#00E5FF><b>\u041A\u0420\u0415\u0414\u0418\u0422\u042B</b></color>\n\u041A\u0440\u0435\u0434\u0438\u0442\u044B \u0434\u0430\u044E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0430 \u0434\u043E\u0431\u0438\u0432\u0430\u043D\u0438\u0435: \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B \u043F\u043E \u043C\u0438\u043D\u044C\u043E\u043D\u0443, \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u0443 \u0438\u043B\u0438 \u0433\u0435\u0440\u043E\u044E. \u0422\u0440\u0430\u0442\u044C \u0438\u0445 \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435 \u043D\u0430 \u0431\u0430\u0437\u0435 \u0438\u043B\u0438 \u0432 \u0434\u0436\u0443\u043D\u0433\u043B\u044F\u0445. \u041C\u0430\u0433\u0430\u0437\u0438\u043D \u043D\u0435 \u0441\u0442\u0430\u0432\u0438\u0442 \u0438\u0433\u0440\u0443 \u043D\u0430 \u043F\u0430\u0443\u0437\u0443.\n\n<color=#00E5FF><b>\u041A\u0410\u0420\u0422\u0410</b></color>\n\u0414\u0432\u0435 \u043B\u0438\u043D\u0438\u0438, \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438 \u0434\u0436\u0443\u043D\u0433\u043B\u0438 \u0441 \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u0430\u043C\u0438 \u0438 Pitmonster (+25% \u0443\u0440\u043E\u043D\u0430 \u043A\u043E\u043C\u0430\u043D\u0434\u0435 \u043D\u0430 90 \u0441). \u0416\u0451\u043B\u0442\u044B\u0435 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044B \u043F\u0435\u0440\u0435\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u044E\u0442 \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u0435\u043D\u044B. \u0427\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0431\u0430\u0448\u0435\u043D \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430 \u043A\u043E\u043C\u0430\u043D\u0434\u0430, \u0442\u0435\u043C \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u043C\u0438\u043D\u044C\u043E\u043D\u044B \u0432\u0440\u0430\u0433\u0430."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
